{
  "name": "big-wicks-fireworks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx tests/run-integration.ts",
    "db:generate": "prisma generate",
    "catalog:audit": "node --conditions=react-server --import tsx scripts/catalog-audit.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sanity/client": "8.5.0",
    "@sanity/icons": "5.2.1",
    "argon2": "0.45.1",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.32",
    "next-sanity": "13.3.4",
    "pg": "8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "6.12.0",
    "server-only": "0.0.1",
    "styled-components": "6.5.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
