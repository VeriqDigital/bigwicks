generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(254)
  passwordHash   String?
  role           Role      @default(CUSTOMER)
  active         Boolean   @default(false)
  sessionVersion Int       @default(0)
  customer       Customer?
  accountTokens  AccountToken[]
  submittedOrders Order[]
  orderSheetVersions OrderSheetVersion[]
  orderSheetDrafts OrderSheetDraft[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Customer {
  id             String      @id @default(cuid())
  userId         String      @unique
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  companyName    String      @db.VarChar(200)
  customerNumber String?     @unique @db.VarChar(100)
  pricingTierId  String
  pricingTier    PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  active         Boolean     @default(false)
  orders         Order[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([pricingTierId])
}

model PricingTier {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(100)
  rank      Int        @unique
  customers Customer[]
  productPrices ProductPrice[]
  orderSheetVersions OrderSheetVersion[]
  orderSheetDrafts OrderSheetDraft[]
  orderSheetActive OrderSheetActive?
}

model ProductPrice {
  catalogKey    String      @db.Uuid
  pricingTierId String
  pricingTier   PricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  price         Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@id([catalogKey, pricingTierId])
  @@index([pricingTierId])
}

model LoginRateLimit {
  key       String   @id @db.VarChar(64)
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum OrderStatus {
  SUBMITTED
}

enum OrderNotificationStatus {
  PENDING
  ACCEPTED
  FAILED
}

model Order {
  id                     String @id @default(cuid())
  reference              String @unique @db.VarChar(23)
  submissionId           String @db.Uuid
  reviewHash             String @db.VarChar(64)
  customerId             String
  customer               Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  submittedByUserId      String
  submittedByUser        User @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  status                 OrderStatus @default(SUBMITTED)
  companyNameSnapshot    String @db.VarChar(200)
  customerNumberSnapshot String? @db.VarChar(100)
  emailSnapshot          String @db.VarChar(254)
  pricingTierIdSnapshot  String
  pricingTierNameSnapshot String @db.VarChar(100)
  total                  Decimal @db.Decimal(18, 2)
  createdAt              DateTime @default(now())
  notificationStatus     OrderNotificationStatus @default(PENDING)
  notificationAcceptedAt DateTime?
  notificationHasAttachment Boolean @default(false)
  items                  OrderItem[]
  excelExport            OrderExport?

  @@unique([customerId, submissionId])
  @@index([createdAt, id])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                   String @id @default(cuid())
  orderId              String
  order                Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  catalogKey           String @db.Uuid
  skuSnapshot          String @db.VarChar(100)
  productNameSnapshot  String @db.VarChar(200)
  brandSnapshot        String? @db.VarChar(100)
  packingSnapshot      String? @db.VarChar(100)
  unitPriceSnapshot    Decimal @db.Decimal(12, 2)
  quantity             Int
  lineTotalSnapshot    Decimal @db.Decimal(18, 2)

  @@unique([orderId, catalogKey])
}

enum AccountTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
}

model AccountToken {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String              @unique @db.VarChar(64)
  purpose        AccountTokenPurpose
  sessionVersion Int
  expiresAt      DateTime
  consumedAt     DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// Files never appear in ordinary tier/order projections. Versions are append-only.
model OrderSheetVersion {
  id String @id @default(cuid())
  tierId String
  tier PricingTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  original Bytes
  checksum String @db.VarChar(64)
  filename String @db.VarChar(120)
  parserVersion String @db.VarChar(40)
  configuration Json
  uploadedById String
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt DateTime
  activatedAt DateTime @default(now())
  active OrderSheetActive?
  exports OrderExport[]
  @@unique([id, tierId])
  @@index([tierId, activatedAt])
}

model OrderSheetActive {
  tierId String @id
  tier PricingTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  versionId String? @unique
  version OrderSheetVersion? @relation(fields: [versionId, tierId], references: [id, tierId], onDelete: Restrict)
  revision Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([versionId, tierId])
}

model OrderSheetDraft {
  id String @id @default(cuid())
  tierId String
  tier PricingTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  original Bytes
  checksum String @db.VarChar(64)
  filename String @db.VarChar(120)
  inspection Json
  stateHash String @db.VarChar(64)
  expectedRevision Int
  uploadedById String
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  sessionVersion Int
  uploadedAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}

enum OrderExportState {
  PENDING
  GENERATING
  READY
  FAILED
}

enum OrderExportKind {
  TEMPLATE
  SNAPSHOT
}

model OrderExport {
  orderId String @id
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  templateId String?
  templateAbsence String? @db.VarChar(40)
  template OrderSheetVersion? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  state OrderExportState @default(PENDING)
  kind OrderExportKind?
  diagnostic String? @db.VarChar(40)
  bytes Bytes?
  checksum String? @db.VarChar(64)
  generatorVersion String? @db.VarChar(40)
  claimId String? @db.Uuid
  claimedAt DateTime?
  createdAt DateTime @default(now())
  generatedAt DateTime?
  @@index([state, claimedAt])
}
