NEXT_PUBLIC_SITE_URL=https://www.example.com

# Sanity: public, non-secret product/category content only. No wholesale prices.
# Leave empty for an unconfigured Studio; lint/typecheck/build still work.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Public dataset reads require no API token. Studio editors sign in to Sanity.

# Contact form delivery through the Resend Email API.
RESEND_API_KEY=re_replace_with_your_api_key
CONTACT_FROM_EMAIL=Big Wicks Website <website@your-verified-domain.com>
CONTACT_TO_EMAIL=replace-with-the-store-inbox@example.com
# Account setup/reset mail. Use a Resend-verified sender; shares RESEND_API_KEY.
# Links use the server-only AUTH_URL canonical origin below.
ACCOUNT_FROM_EMAIL=Big Wicks Accounts <accounts@your-verified-domain.com>

# PostgreSQL. Use an isolated local database for development; production requires TLS.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/big_wicks
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Local origin; use the exact HTTPS deployment origin in production.
AUTH_URL=http://localhost:3000
# Only set true behind a trusted ingress that overwrites Host/forwarded headers.
# Vercel is automatically detected by Auth.js; otherwise review before enabling.
AUTH_TRUST_HOST=false

# Local development seed only. Each password must contain 15–128 characters.
ALLOW_DEVELOPMENT_SEED=false
SEED_ADMIN_PASSWORD=
SEED_TIER1_PASSWORD=
SEED_TIER2_PASSWORD=
