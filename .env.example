# Development template only; never copy these defaults into Preview/Production.
# Full variable inventory and release gates: docs/PRODUCTION-READINESS.md section 5.
# Set both URL variables to the same approved HTTPS origin for Production.
# NEXT_PUBLIC values are baked into the build: rebuild after changing them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: public, non-secret product/category content only. No wholesale prices.
# Leave empty for an unconfigured Studio; lint/typecheck/build still work.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Public dataset reads require no API token. Studio editors sign in to Sanity.
# Operator CLI only; never set a NEXT_PUBLIC write token or import this into app code.
# Omit this token and both catalog import controls from Vercel application scopes.
# Remote onboarding dry-runs also need full read access to detect drafts/releases.
SANITY_API_WRITE_TOKEN=
# Explicit project/dataset pair designated non-production; empty guards ALL targets.
SANITY_CATALOG_NON_PRODUCTION_TARGET=
# Production additionally requires --allow-production, --confirm and reviewed --apply hash.
ALLOW_PRODUCTION_CATALOG_IMPORT=false

# Contact form delivery through the Resend Email API.
# Leave mail disabled until sender/recipient approval and provider verification.
# Preview should omit the key by default. The app has no recipient sandbox:
# account mail goes to SQL User.email, regardless of CONTACT_TO_EMAIL/ORDER_TO_EMAIL.
RESEND_API_KEY=
# Expected shape: Big Wicks Website <website@your-verified-domain.example>
CONTACT_FROM_EMAIL=
# One confirmed store inbox; no fallback recipient.
CONTACT_TO_EMAIL=
# Account setup/reset mail. Use a Resend-verified sender; shares RESEND_API_KEY.
# Links use the server-only AUTH_URL canonical origin below.
# Expected shape: Big Wicks Accounts <accounts@your-verified-domain.example>
ACCOUNT_FROM_EMAIL=
# Staff order notifications: confirm the intended recipient before configuring.
# Shares ACCOUNT_FROM_EMAIL and RESEND_API_KEY; no fallback to contact recipients.
ORDER_TO_EMAIL=

# PostgreSQL. Use an isolated local database for development; production requires TLS.
# The app does not identify Production vs Preview from this URL. Verify the target
# branch/database/role independently. Migration operators inject their deliberate
# connection as DATABASE_URL; DIRECT_URL is not read by this repository.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/big_wicks
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Local origin; use the exact HTTPS deployment origin in production.
AUTH_URL=http://localhost:3000
# Only set true behind a trusted ingress that overwrites Host/forwarded headers.
# Vercel is automatically detected by Auth.js; otherwise review before enabling.
AUTH_TRUST_HOST=false
# Do not set legacy NEXTAUTH_URL/NEXTAUTH_SECRET, AUTH_SECRET_1/2/3 or
# AUTH_REDIRECT_PROXY_URL as substitutes for the application variables above.

# Local development seed only. Each password must contain 15–128 characters.
# Omit all four seed variables in Preview/Production. This seed creates fictional
# accounts, not the first production ADMIN. Never run it through a production tunnel.
ALLOW_DEVELOPMENT_SEED=false
SEED_ADMIN_PASSWORD=
SEED_TIER1_PASSWORD=
SEED_TIER2_PASSWORD=

# Platform-owned NODE_ENV / VERCEL are not configured here. Preview builds also
# use NODE_ENV=production; that value is not an environment-separation guard.
# TEST_ACCOUNT_MAIL_DIR, TEST_CATALOG_CONTENT_FILE, NODE_OPTIONS test preloads and
# NEXT_FONT_GOOGLE_MOCKED_RESPONSES belong only to the isolated test harness.
